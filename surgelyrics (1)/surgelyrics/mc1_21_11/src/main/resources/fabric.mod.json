  "environment": "client",
  "entrypoints": { "client": ["dev.surgelyrics.mc1_21_11.SurgeLyricsClient"] },
  "mixins": [ { "config": "surgelyrics.mixins.json", "environment": "client" } ],
  "depends": {
    "fabricloader": ">=0.18.0",
    "minecraft": "~1.21.11",
    "java": ">=21",
    "fabric-api": "*"
  }
}
